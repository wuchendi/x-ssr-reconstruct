{
  "name": "x-ssr-reconstruct",
  "private": true,
  "type": "module",
  "scripts": {
    "relay": "relay-compiler",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "build:routes": "node scripts/ngroutes.ts > dist/ngroutes.json",
    "build": "pnpm relay && pnpm build:client && pnpm build:server && pnpm build:routes && node scripts/precompress.ts",
    "start": "node server/main.ts",
    "start:watt": "wattpm start"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "graphql": "^17.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-relay": "^21.0.1",
    "relay-runtime": "^21.0.1"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@platformatic/node": "^3.78.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-relay": "^21.0.1",
    "htmlparser2": "^12.0.0",
    "playwright": "1.64.1",
    "relay-compiler": "^21.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "wattpm": "^3.78.0"
  },
  "license": "Apache-2.0"
}
